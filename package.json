{
  "name": "jichangjiedian-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "机场节点（jichangjiedian.blog）— 环球节点航线地图与分时段网络表现研究站",
  "license": "UNLICENSED",
  "dependencies": {
    "@astrojs/mdx": "^8.1.1",
    "astro": "^7.4.2",
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0",
    "typescript": "^6.0.3",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.6.5",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "node-html-parser": "^9.0.5",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.72.1"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "tsc --noEmit -p .",
    "validate:brands": "tsx scripts/validate-brands.ts",
    "validate:affiliates": "tsx scripts/validate-affiliates.ts",
    "validate:evidence": "tsx scripts/validate-evidence.ts",
    "validate:seo": "tsx scripts/validate-seo.ts",
    "validate:links": "tsx scripts/validate-links.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "validate:search": "tsx scripts/validate-search.ts",
    "validate:security": "tsx scripts/validate-security.ts",
    "validate": "npm run validate:brands && npm run validate:affiliates && npm run validate:evidence",
    "validate:dist": "npm run validate:seo && npm run validate:links && npm run validate:content && npm run validate:search && npm run validate:security",
    "check:external": "tsx scripts/check-external-links.ts",
    "check:originality": "tsx scripts/check-originality.ts",
    "report:pages": "tsx scripts/report-pages.ts",
    "report:sources": "tsx scripts/report-sources.ts",
    "test:e2e": "tsx tests/e2e.ts",
    "test:mobile": "tsx tests/mobile.ts",
    "test:a11y": "tsx tests/a11y.ts",
    "test": "npm run test:e2e && npm run test:mobile && npm run test:a11y",
    "indexnow": "tsx scripts/submit-indexnow.ts",
    "verify": "npm run lint && npm run typecheck && npm run validate && npm run build && npm run validate:dist",
    "images": "tsx scripts/make-webp.ts",
    "icons": "tsx scripts/make-icons.ts",
    "lint": "eslint ."
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
