---
import { NAV_ITEMS, SITE_NAME, SOCIAL_LINKS } from '../lib/site';
const social = SOCIAL_LINKS.filter((l) => l.href);
interface Props {
  path: string;
}
const { path } = Astro.props;

const isCurrent = (href: string): boolean => {
  if (href.startsWith('/#')) return path === '/';
  return path === href || path.startsWith(href);
};
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label={`${SITE_NAME} 首页`}>
      <svg class="brand__mark" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
        <rect width="40" height="40" rx="9" fill="#214986"></rect>
        <path d="M9 28Q18 8 31 13" fill="none" stroke="#58CEFF" stroke-width="2.4" stroke-linecap="round"></path>
        <circle cx="9" cy="28" r="3.2" fill="#58CEFF"></circle>
        <circle cx="31" cy="13" r="3.2" fill="#F5B36C"></circle>
      </svg>
      <span class="brand__name">{SITE_NAME}</span>
    </a>

    <div class="site-tools">
    <form class="site-search" role="search" aria-label="站内搜索" action="/search/" method="get" data-site-search>
      <label class="visually-hidden" for="site-q">搜索机场、地区、线路和文章</label>
      <input
        class="site-search__input"
        id="site-q"
        name="q"
        type="search"
        placeholder="搜索机场、地区"
        autocomplete="off"
        enterkeyhint="search"
        maxlength="40"
      />
      <div class="site-search__panel" id="site-search-panel" role="listbox" aria-label="搜索结果" hidden></div>
    </form>
    {
      social.length > 0 && (
        <ul class="site-social" aria-label="社群">
          {social.map((l) => (
            <li>
              <a class="site-social__link" href={l.href!} target="_blank" rel="noopener noreferrer" title={l.label} aria-label={`${l.label}（在新窗口打开）`}>
                {l.key === 'telegram' ? (
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M21 4 3 11l6 2.2M21 4l-3 16-9-6.8M21 4 9 13.2V19l3.2-3.4" /></svg>
                ) : (
                  <svg class="is-fill" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" /></svg>
                )}
              </a>
            </li>
          ))}
        </ul>
      )
    }
    </div>

    <nav class="site-nav" aria-label="主导航">
      <ul class="site-nav__list">
        {
          NAV_ITEMS.map((it) => (
            <li>
              <a class="site-nav__link" href={it.href} title={it.hint} aria-current={isCurrent(it.href) ? 'page' : undefined}>
                {it.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
