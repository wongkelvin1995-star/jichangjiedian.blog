---
/**
 * 火焰框上沿往上飘的火星（装饰）。火焰本身是框的伪元素贴图（见 flame.css 的 .flame-frame / .bcard--hot），
 * 这里只放几粒火星。容器需要 position: relative。
 * size="lg" 主推区；"sm" 机场卡片与品牌页价格卡；"xs" 侧栏。
 * 只有 CSS transform/opacity 动画，不接收鼠标事件，读屏软件忽略；系统开启“减少动态效果”时火星不出现。
 */
interface Props { size?: 'lg' | 'sm' | 'xs' }
const { size = 'lg' } = Astro.props;
const embers = { lg: 7, sm: 4, xs: 3 }[size]!;
---

<div class={`flames flames--${size}`} aria-hidden="true">
  {Array.from({ length: embers }, () => <span class="ember"></span>)}
</div>
