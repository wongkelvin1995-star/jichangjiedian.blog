---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { loadPosts } from '../../lib/content';
import { collectionLd } from '../../lib/seo';
import { fmtDate } from '../../lib/format';
import { DATA_UPDATED } from '../../lib/site';

const path = '/articles/';
const title = '研究文章：节点选择、分时段测速与线路知识｜机场节点';
const description = '机场节点站的原创研究文章：怎样选节点、晚高峰为什么变慢、香港与日本怎么选、IEPL 与 IPLC 的区别、空载与负载延迟，每篇都写明方法与局限。';
const posts = (await loadPosts()).filter((p) => p.kind === 'articles');
const modified = posts.map((p) => p.modified).sort().pop() ?? DATA_UPDATED;
const crumbs = [
  { name: '首页', href: '/' },
  { name: '研究文章', href: path },
];
const byId = new Map(posts.map((p) => [p.id, p]));
/** 按读者的问题分组的阅读路线；标题取自文章本身，改标题时这里自动跟随 */
const ROUTES = [
  { need: '刚开始选机场', ids: ['how-to-choose-airport-nodes-2026', 'how-to-speedtest-at-peak-hours'] },
  { need: '看不懂测速里的数字', ids: ['idle-vs-loaded-latency', 'low-latency-not-fast-download', 'jitter-impact-on-use-cases'] },
  { need: '想了解线路和地区', ids: ['iepl-iplc-bgp-differences', 'hong-kong-vs-japan-nodes', 'singapore-vs-us-nodes'] },
  { need: '想弄清套餐和稳定性', ids: ['traffic-multiplier-explained', 'online-rate-vs-stability', 'why-nodes-slow-down-at-night'] },
  { need: '想看本站的实测怎么读', ids: ['singapore-node-speedtest-metrics'] },
].map((g) => ({ need: g.need, items: g.ids.map((id) => byId.get(id)).filter((p): p is NonNullable<typeof p> => !!p) }));
---

<BaseLayout {title} {description} {path} breadcrumbs={crumbs} {modified} jsonLd={[collectionLd('机场节点研究文章', description, path, posts.map((p) => ({ name: p.h1, href: p.href })))]}>
  <header class="page-head">
    <div class="container">
      <h1>研究文章：看懂节点速度、延迟与稳定性</h1>
      <p class="page-head__lead">每篇文章只讲一个问题，写明依据、方法和局限，不用没有来源的数字，也不替任何机场做担保。</p>
      <p class="page-head__meta"><span>共 {posts.length} 篇</span><span>最近更新 {fmtDate(modified)}</span></p>
    </div>
  </header>
  <div class="container section section--tight">
    <section class="mb-7" aria-labelledby="start-title">
      <h2 id="start-title" class="mb-3">按你的问题，从这几篇读起</h2>
      <dl class="route-list">
        {
          ROUTES.map((g) => (
            <div>
              <dt>{g.need}</dt>
              <dd>
                {g.items.map((p, i) => (
                  <>
                    {i > 0 && '、'}
                    <a href={p.href}>{p.h1}</a>
                  </>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>
    {posts.length > 0 ? <PostList {posts} /> : <p class="empty">文章正在整理中。</p>}
    <p class="mt-6 text-sm text-soft">
      想动手测试，可以看<a href="/guides/">客户端教程</a>；数据与方法见<a href="/time-tests/">分时段节点测试</a>和<a href="/testing-methodology/">测试方法</a>。
    </p>
  </div>
</BaseLayout>
